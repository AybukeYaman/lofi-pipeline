{
  "name": "lofi-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lofi video montaj otomasyonu (ffmpeg tabanlı)",
  "engines": {
    "node": ">=22"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "node lofi.js",
    "dev": "node server/web-server.js",
    "web": "node server/web-server.js",
    "web:client": "vite --config web/vite.config.ts --host 127.0.0.1",
    "web:client:build": "vite build --config web/vite.config.ts",
    "electron:start": "electron .",
    "electron:dev": "npm run web:client:build && electron .",
    "electron:build": "npm run web:client:build && electron-builder --win nsis --x64",
    "dist": "npm run electron:build",
    "tty-check": "node scripts/tty-check.js",
    "tui-check": "node scripts/tui-check.js",
    "build": "node build.js",
    "test": "node --test \"test/unit/*.test.js\" \"test/branches/*.test.js\"",
    "test:web": "vitest run --config web/vitest.config.ts",
    "test:all": "npm test && npm run test:web",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:regression": "node --test-reporter=spec test/regression.js",
    "test:regression:update": "node --test-reporter=spec test/regression.js --update"
  },
  "dependencies": {
    "enquirer": "2.4.1",
    "ink": "7.1.1",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "ink-testing-library": "4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.lofi.automation",
    "productName": "LoFi Automation",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "server/**/*",
      "prep/**/*",
      "prompts/**/*",
      "core/**/*",
      "steps/**/*",
      "styles/**/*",
      "ui/**/*",
      "web/dist/**/*",
      "*.js",
      "!test/**/*",
      "!web/src/**/*"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LoFi Automation"
    }
  }
}
